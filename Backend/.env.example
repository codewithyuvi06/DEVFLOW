NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/devflow
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
COOKIE_NAME=devflow_session
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# Optional GitHub OAuth integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/integrations/github/callback
